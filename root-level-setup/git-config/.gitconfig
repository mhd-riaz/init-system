[user]
	name = mohamed-riaz_kyndryl
	email = mohamed.riaz@kyndryl.com
	signingkey = /Users/riaz/.ssh/id_ed25519_personal.pub

[includeIf "gitdir:/Users/riaz/Documents/personal/"]
    path = ~/.gitconfig-personal

[includeIf "hasconfig:remote.*.url:*cto*"]
	path = ~/.gitconfig-kyndryl

[includeIf "hasconfig:remote.*.url:*kyndryl*"]
	path = ~/.gitconfig-kyndryl

[gpg]
	format = ssh
[push]
	autoSetupRemote = true
